{
  "name": "appointmentApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "clean": "rm -rf android/build && rm -rf node_modules && npm install",
    "lint": "eslint .",
    "start": "react-native start",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --runInBand --ci --coverage",
    "test:file": "jest --runTestsByPath",
    "test": "jest",
    "test:forgot": "jest __tests__/features/auth/Forgot.screen.test.tsx --clearCache",
    "test:forgot:success": "jest __tests__/features/auth/Forgot.screen.test.tsx -t 'success message after submit' --clearCache",
    "test:config": "node test-config.js",
    "android:dev": "react-native run-android --mode=developmentDebug --appId=com.appointmentapp.development",
    "android:stag": "react-native run-android --mode=stagingRelease --appId=com.appointmentapp.staging",
    "android:prod": "react-native run-android --mode=productionRelease --appId=com.appointmentapp",
    "android:debug": "cd android && ./gradlew assembleDevelopmentDebug",
    "android:release": "cd android && ./gradlew assembleStagingRelease",
    "android:bundle": "cd android && ./gradlew clean && ./gradlew assembleStagingRelease",
    "clean:hard": "rm -rf node_modules package-lock.json yarn.lock android/build android/app/build ~/Library/Caches/Metro \"$TMPDIR\"/metro-* \"$TMPDIR\"/haste-map-*"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/native": "^7.1.26",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.2",
    "react": "^19.2.0",
    "react-native": "0.83.1",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.19.0",
    "react-native-worklets": "^0.7.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.28.4",
    "@eslint/eslintrc": "^2.1.4",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "^19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
